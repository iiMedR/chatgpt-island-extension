{
  "name": "chatgpt-island",
  "version": "0.9.5",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx scripts/build.ts --watch",
    "build": "tsx scripts/build.ts && npm --prefix server run build",
    "typecheck": "tsc --noEmit && npm --prefix server run typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:browser": "npm run build:offline && playwright test",
    "server:dev": "npm --prefix server run dev",
    "server:build": "npm --prefix server run build",
    "build:offline": "tsx scripts/build.ts --offline",
    "dev:offline": "tsx scripts/build.ts --watch --offline",
    "test:backend-browser": "tsx scripts/build.ts --mock-backend && playwright test -c playwright.backend.config.ts",
    "package:preview": "npm run build && tsx scripts/package-release.ts",
    "verify:package": "tsx scripts/verify-release.ts"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@types/chrome": "^0.1.24",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "axe-core": "^4.14.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fflate": "^0.8.3",
    "globals": "^17.14.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.6.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.2.0",
    "vitest": "~4.1.11"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
