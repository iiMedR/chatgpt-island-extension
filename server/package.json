{
  "name": "chatgpt-island-server",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx src/index.ts",
    "start": "node --env-file-if-exists=.env dist/server/src/index.js",
    "build": "tsc -p vendor/siwc-local/tsconfig.json && tsc -p tsconfig.json",
    "typecheck": "tsc -p vendor/siwc-local/tsconfig.json && tsc -p tsconfig.json --noEmit",
    "sdk:build": "tsc -p vendor/siwc-local/tsconfig.json"
  },
  "dependencies": {
    "@siwc/local": "file:vendor/siwc-local",
    "fastify": "^5.12.8",
    "openai": "^7.53.0"
  },
  "devDependencies": {
    "@types/proper-lockfile": "^4.1.4"
  }
}
